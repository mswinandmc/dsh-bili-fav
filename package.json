{
  "name": "dsh-bili-qq",
  "version": "1.0.0-rc1",
  "description": "B站自主刷片 + 今天的鱼：agent 在 DSH 会话里刷推荐、写理由，并通过内置腾讯 QQ 官方 API 推送。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "vendor",
    "locale",
    "icon.svg",
    "README.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "bilibili",
    "b站",
    "qq",
    "tencent",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mswinandmc/dsh-bili-qq.git"
  },
  "homepage": "https://github.com/mswinandmc/dsh-bili-qq#readme",
  "bugs": {
    "url": "https://github.com/mswinandmc/dsh-bili-qq/issues"
  },
  "author": "mswinandmc",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check-manifest.mjs && npm test",
    "pack:check": "npm pack --dry-run"
  }
}
