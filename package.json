{
  "name": "dsh-bili-fav",
  "version": "0.2.0-beta.14",
  "description": "用你的 B站账号刷推荐流，让模型自己点开视频、读字幕、按自己的品味挑片，并收藏到你自定义的收藏夹。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "vendor",
    "locale",
    "icon.svg",
    "README.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "bilibili",
    "b站",
    "favorites",
    "收藏夹",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mswinandmc/dsh-bili-fav.git"
  },
  "homepage": "https://github.com/mswinandmc/dsh-bili-fav#readme",
  "bugs": {
    "url": "https://github.com/mswinandmc/dsh-bili-fav/issues"
  },
  "author": "mswinandmc",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check-manifest.mjs && npm test",
    "pack:check": "npm pack --dry-run"
  }
}
