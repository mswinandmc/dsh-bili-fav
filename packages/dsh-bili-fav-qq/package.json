{
  "name": "dsh-bili-fav-qq",
  "version": "0.1.0",
  "description": "QQ Bot channel adapter for dsh-bili-fav",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mswinandmc/dsh-bili-fav.git",
    "directory": "packages/dsh-bili-fav-qq"
  },
  "homepage": "https://github.com/mswinandmc/dsh-bili-fav/tree/main/packages/dsh-bili-fav-qq#readme",
  "bugs": {
    "url": "https://github.com/mswinandmc/dsh-bili-fav/issues"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "bilibili",
    "qqbot",
    "channel"
  ]
}
